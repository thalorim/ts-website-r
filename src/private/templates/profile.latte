{extends "body.latte"}
{var $title = 'Profile'}

{block content}
    <div class="profile-header steamlike-header card-accent">
        <div class="cover" n:attr="style => isset($bannerUrl) && $bannerUrl ? 'background-image:url(' . $bannerUrl . '); background-size:cover; background-position:center;' : null"></div>
        <div class="avatar-and-meta d-flex align-items-center">
            <div class="d-flex align-items-center">
                <div class="avatar">
                    <img src="{$avatarUrl}" alt="avatar">
                </div>
                <div class="meta ml-3">
                    <h3 class="nickname mb-1 d-flex align-items-center">
                        <span>{$profile["nickname"] ?? ("User #" . $profile["cldbid"]) }</span>
                        {ifset $groups}
                            {foreach $groups as $g}
                                {if $g['sgid'] === 6}
                                    <img src="https://cdn3.emoji.gg/emojis/28948-staff.png" alt="Group 6" class="ml-2" style="height:24px;width:24px;object-fit:contain;vertical-align:middle;" data-toggle="tooltip" title="Group 6">
                                    {breakIf true}
                                {/if}
                            {/foreach}
                        {/ifset}
                    </h3>
                    <div class="subtext">
                        <span><i class="fas fa-id-badge"></i> CLDBID: {$profile["cldbid"]}</span>
                        {ifset $profile["cluid"]}
                            <span class="ml-2"><i class="fas fa-fingerprint"></i> {$profile["cluid"]}</span>
                        {/ifset}
                        {if $socials}
                            <span class="ml-3">
                                {foreach $socials as $s}
                                    <a href="{$s['url']}" target="_blank" rel="noopener" class="ml-2" data-toggle="tooltip" title="{$s['key']}">
                                        <i class="{$s['icon']}"></i>
                                    </a>
                                {/foreach}
                            </span>
                        {/if}
                    </div>
                    <div class="online-subtext mt-2">
                        {if $isOnline}
                            <span class="status-dot green"></span>
                            <small>
                                Online since
                                {ifset $profile["online_since_text"]}
                                    {$profile["online_since_text"]}
                                {elseifset $profile["online_since_ms"]}
                                    {round(($profile["online_since_ms"] / 1000) / 60)} minutes
                                {else}
                                    a moment
                                {/ifset}
                                {ifset $currentChannelName}
                                    • talking on {ifset $currentChannelId}<a href="ts3server://web.reape.rs?cid={$currentChannelId}">{$currentChannelName}</a>{else}{$currentChannelName}{/ifset}
                                {/ifset}
                            </small>
                        {else}
                            <span class="status-dot gray"></span>
                            <small>
                                Offline{ifset $lastSeenText} • last seen {$lastSeenText}{/ifset}
                            </small>
                        {/if}
                    </div>
                </div>
            </div>
            {ifset $rankImageUrl}
                <div class="ml-auto">
                    <img src="{$rankImageUrl}" alt="Rank {$rankLevel}" style="height:48px;width:auto;">
                </div>
            {/ifset}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-user"></i> Overview
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Country:</strong> {ifset $profile["country"]}
                        <img src="https://reape.rs/flags/{strtolower($profile['country'])}.png" alt="flag" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;"> {$profile["country"]}
                    {else}-{/ifset}</p>
                    <p><strong>Platform:</strong> {$profile["platform"] ?? '-'}</p>
                    <p><strong>Version:</strong> {$profile["version"] ?? '-'}</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total connections:</strong> {ifset $profile["totalconnections"]}{$profile["totalconnections"]}{else}-{/ifset}</p>
                    <p><strong>First connected:</strong> {$profile["first_connected_human"] ?? '-'}</p>
                    <p><strong>Last online:</strong> {$profile["last_online_human"] ?? '-'}</p>
                    {ifset $discordUserId}
                        <div id="discord-widget" class="mt-3 p-2 border rounded d-flex align-items-center" style="background: rgba(0,0,0,.03);">
                            <div class="position-relative mr-2" style="width:40px;height:40px;">
                                <img id="discord-avatar" src="https://placehold.co/80x80" alt="discord avatar" style="width:40px;height:40px;border-radius:50%;object-fit:cover;">
                                <span id="status-indicator" class="status-indicator" style="position:absolute;right:-2px;bottom:-2px;width:12px;height:12px;border-radius:50%;border:2px solid #fff;background:#9e9e9e;"></span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center">
                                    <strong id="discord-username" class="mr-2">Discord</strong>
                                    <small id="discord-username-display" class="text-muted"></small>
                                </div>
                                <small id="discord-status-text" class="text-muted">Loading...</small>
                            </div>
                            <a id="discord-profile-link" href="https://discord.com/users/{$discordUserId}" target="_blank" rel="noopener" class="btn btn-sm btn-primary ml-2">
                                <i class="fab fa-discord"></i>
                            </a>
                        </div>
                    {/ifset}
                </div>
            </div>
            <hr>
            <p><strong>Description</strong></p>
            <div class="desc">{ifset $profile["description"]}{$profile["description"]|noescape}{else}<em>No description</em>{/ifset}</div>
        </div>
    </div>

{block footerbottom}
    {ifset $discordUserId}
        <script>
            (function(){
                function applyDiscordStatus(status){
                    var statusIndicator = document.getElementById('status-indicator');
                    var statusText = document.getElementById('discord-status-text');
                    if(!statusIndicator || !statusText) return;
                    var color = '#9e9e9e';
                    var label = 'Offline';
                    if(status === 'online'){ color = '#43b581'; label = 'Online'; }
                    else if(status === 'idle'){ color = '#faa61a'; label = 'Away'; }
                    else if(status === 'dnd'){ color = '#f04747'; label = 'Do Not Disturb'; }
                    else if(status === 'offline'){ color = '#9e9e9e'; label = 'Offline'; }
                    statusIndicator.style.background = color;
                    statusText.textContent = label;
                }

                async function fetchDiscordUser(){
                    var userId = '{$discordUserId}';
                    if(!userId){ return; }
                    var userApiUrl = 'https://api.lanyard.rest/v1/users/' + encodeURIComponent(userId);
                    try {
                        var res = await fetch(userApiUrl, { credentials: 'omit' });
                        var data = await res.json();
                        if(data && data.success){
                            var user = data.data.discord_user;
                            var status = data.data.discord_status;
                            var avatarEl = document.getElementById('discord-avatar');
                            var nameEl = document.getElementById('discord-username');
                            var handleEl = document.getElementById('discord-username-display');
                            if(avatarEl){
                                if(user && user.avatar){
                                    avatarEl.src = 'https://cdn.discordapp.com/avatars/' + user.id + '/' + user.avatar + '.png?size=128';
                                } else {
                                    avatarEl.src = 'https://placehold.co/80x80';
                                }
                            }
                            if(nameEl){ nameEl.textContent = (user && (user.display_name || user.username)) || 'Discord'; }
                            if(handleEl){ handleEl.textContent = user && user.username ? ('@' + user.username) : ''; }
                            applyDiscordStatus(status);
                        } else {
                            applyDiscordStatus('offline');
                        }
                    } catch(e){
                        applyDiscordStatus('offline');
                        if(window && window.console){ console.warn('Discord fetch failed', e); }
                    }
                }

                // init and poll
                fetchDiscordUser();
                setInterval(fetchDiscordUser, 30000);
            })();
        </script>
    {/ifset}
{/block}

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users"></i> Server groups
        </div>
        <div class="card-body">
            {if $groups}
                {foreach $groups as $g}
                    <span class="badge badge-primary mr-1 mb-1" data-toggle="tooltip" title="ID: {$g['sgid']}">
                        {if $g['iconid']}
                            <img src="api/geticon.php?iconid={$g['iconid']}" alt="{$g['name']}" style="height:16px;width:16px;vertical-align:middle;margin-right:.25rem;">
                        {/if}
                        {$g['name']}
                    </span>
                {/foreach}
            {else}
                <em>No groups</em>
            {/if}
        </div>
    </div>
{/block}

