{extends "body.latte"}
{var $title = 'Profile'}

{block content}
    <div class="profile-header steamlike-header card-accent">
        <div class="cover" n:attr="style => isset($bannerUrl) && $bannerUrl ? 'background-image:url(' . $bannerUrl . '); background-size:cover; background-position:center;' : null"></div>
        <div class="avatar-and-meta d-flex align-items-center" n:attr="style => isset($avatarMetaBgStyle) && $avatarMetaBgStyle ? $avatarMetaBgStyle : null">
            <div class="d-flex align-items-center">
                <div class="avatar avatar-preview">
                    <img src="{$avatarUrl}" alt="avatar" class="avatar-img">
                    <img src="{$avatarBorderUrl}" alt="avatar border" class="avatar-border-overlay">
                </div>
                <div class="meta ml-3">
                    <h3 class="nickname mb-1 d-flex align-items-center" n:class="$nicknameStyle ? 'nickname-' . $nicknameStyle : ''">
                        <span>{$profile["nickname"] ?? ("User #" . $profile["cldbid"]) }</span>
                        {ifset $groups}
                            {foreach $groups as $g}
                                {if $g['sgid'] === 6}
                                    <img src="https://cdn3.emoji.gg/emojis/28948-staff.png" alt="Group 6" class="ml-2" style="height:24px;width:24px;object-fit:contain;vertical-align:middle;" data-toggle="tooltip" title="Group 6">
                                    {breakIf true}
                                {/if}
                            {/foreach}
                        {/ifset}
                    </h3>
                    <div class="subtext">
                        <span><i class="fas fa-id-badge"></i> CLDBID: {$profile["cldbid"]}</span>
                        {ifset $profile["cluid"]}
                            <span class="ml-2"><i class="fas fa-fingerprint"></i> {$profile["cluid"]}</span>
                        {/ifset}
                        {if $socials}
                            <span class="ml-3">
                                {foreach $socials as $s}
                                    <a href="{$s['url']}" target="_blank" rel="noopener" class="ml-2" data-toggle="tooltip" title="{$s['key']}">
                                        <i class="{$s['icon']}"></i>
                                    </a>
                                {/foreach}
                            </span>
                        {/if}
                    </div>
                    <div class="online-subtext mt-2">
                        {if $isOnline}
                            <span class="status-dot green"></span>
                            <small>
                                Online since
                                {ifset $profile["online_since_text"]}
                                    {$profile["online_since_text"]}
                                {elseifset $profile["online_since_ms"]}
                                    {round(($profile["online_since_ms"] / 1000) / 60)} minutes
                                {else}
                                    a moment
                                {/ifset}
                                {ifset $currentChannelName}
                                    • talking on {ifset $currentChannelId}<a href="ts3server://web.reape.rs?cid={$currentChannelId}">{$currentChannelName}</a>{else}{$currentChannelName}{/ifset}
                                {/ifset}
                            </small>
                        {else}
                            <span class="status-dot gray"></span>
                            <small>
                                Offline{ifset $lastSeenText} • last seen {$lastSeenText}{/ifset}
                            </small>
                        {/if}
                    </div>
                </div>
            </div>
            {ifset $rankImageUrl}
                <div class="ml-auto">
                    <img src="{$rankImageUrl}" alt="Rank {$rankLevel}" style="height:48px;width:auto;">
                </div>
            {/ifset}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-user"></i> Overview
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Country:</strong> {ifset $profile["country"]}
                        <img src="https://reape.rs/flags/{strtolower($profile['country'])}.png" alt="flag" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;"> {$profile["country"]}
                    {else}-{/ifset}</p>
                    <p><strong>Platform:</strong> {$profile["platform"] ?? '-'}</p>
                    <p><strong>Version:</strong> {$profile["version"] ?? '-'}</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total connections:</strong> {ifset $profile["totalconnections"]}{$profile["totalconnections"]}{else}-{/ifset}</p>
                    <p><strong>First connected:</strong> {$profile["first_connected_human"] ?? '-'}</p>
                    <p><strong>Last online:</strong> {$profile["last_online_human"] ?? '-'}</p>
                </div>
            </div>
            <hr>
            <p><strong>Description</strong></p>
            {var $hasDiscord = $discordUserId ?? null}
            <div class="row profile-description-row">
                <div class="col-12{if $hasDiscord} col-lg-8{/if}">
                    <div class="desc">{ifset $profile["description"]}{$profile["description"]|noescape}{else}<em>No description</em>{/ifset}</div>
                </div>
                {if $hasDiscord}
                    {var $discordWidgetAvatar = $discordPresence ? $discordPresence["avatarUrl"] : 'https://cdn.discordapp.com/embed/avatars/0.png'}
                    {var $discordWidgetStatusKey = $discordPresence ? $discordPresence["statusKey"] : 'offline'}
                    {var $discordWidgetStatusLabel = $discordPresence ? $discordPresence["statusLabel"] : 'Status unavailable'}
                    {var $discordWidgetDisplay = $discordPresence ? $discordPresence["displayName"] : 'Discord status unavailable'}
                    {var $discordWidgetUsername = ($discordPresence && isset($discordPresence["usernameTag"])) ? $discordPresence["usernameTag"] : ('ID: ' . $discordUserId)}
                    {var $discordWidgetProfileUrl = $discordPresence ? $discordPresence["profileUrl"] : ("https://discord.com/users/" . $discordUserId)}
                    <div class="col-12 col-lg-4 mt-3 mt-lg-0">
                        <div class="discord-widget card-accent{if $discordPresence} discord-widget--has-data{/if}" data-discord-user-id="{$discordUserId}">
                            <div class="discord-widget__header">
                                <span class="discord-widget__label"><i class="fab fa-discord"></i> Discord</span>
                                <span class="discord-widget__status">
                                    <span class="discord-widget__status-dot {$discordWidgetStatusKey}" data-discord-role="status-dot"></span>
                                    <span class="discord-widget__status-text" data-discord-role="status-text">{$discordWidgetStatusLabel}</span>
                                </span>
                            </div>
                            <a href="{$discordWidgetProfileUrl}" target="_blank" rel="noopener"
                               class="discord-widget__body" data-discord-role="profile-link">
                                <img src="{$discordWidgetAvatar}" alt="Discord avatar" class="discord-widget__avatar" data-discord-role="avatar">
                                <div class="discord-widget__meta">
                                    <div class="discord-widget__display-name" data-discord-role="display">{$discordWidgetDisplay}</div>
                                    <div class="discord-widget__username" data-discord-role="username">{$discordWidgetUsername}</div>
                                </div>
                            </a>
                        </div>
                    </div>
                {/if}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users"></i> Server groups
        </div>
        <div class="card-body">
            {if $groups}
                {foreach $groups as $g}
                    <span class="badge badge-primary mr-1 mb-1" data-toggle="tooltip" title="ID: {$g['sgid']}">
                        {if $g['iconid']}
                            <img src="api/geticon.php?iconid={$g['iconid']}" alt="{$g['name']}" style="height:16px;width:16px;vertical-align:middle;margin-right:.25rem;">
                        {/if}
                        {$g['name']}
                    </span>
                {/foreach}
            {else}
                <em>No groups</em>
            {/if}
        </div>
    </div>
{/block}

