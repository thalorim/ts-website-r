{extends "body.latte"}
{var $title = 'Profile'}

{block content}
    <div class="profile-header steamlike-header card-accent">
        <div class="cover" n:attr="style => isset($bannerUrl) && $bannerUrl ? 'background-image:url(' . $bannerUrl . '); background-size:cover; background-position:center;' : null"></div>
        <div class="avatar-and-meta">
            <div class="avatar avatar-preview">
                <img src="{$avatarUrl}" alt="avatar" class="avatar-img">
                <img src="{$avatarBorderUrl}" alt="avatar border" class="avatar-border-overlay">
            </div>
            <div class="meta">
                <h3 class="nickname">
                    <span>{$profile["nickname"] ?? ("User #" . $profile["cldbid"]) }</span>
                    {ifset $groups}
                        {foreach $groups as $g}
                            {if $g['sgid'] === 6}
                                <img src="https://cdn3.emoji.gg/emojis/28948-staff.png" alt="Group 6" class="rank-icon" data-toggle="tooltip" title="Group 6">
                                {breakIf true}
                            {/if}
                        {/foreach}
                    {/ifset}
                </h3>
                <div class="subtext">
                    <i class="fas fa-id-badge" data-toggle="tooltip" title="Database ID: {$profile['cldbid']}"></i>
                    {ifset $profile["cluid"]}
                        <i class="fas fa-fingerprint ml-2" data-toggle="tooltip" title="{$profile['cluid']}"></i>
                    {/ifset}
                    {if $socials}
                        {foreach $socials as $s}
                            <a href="{$s['url']}" target="_blank" rel="noopener" class="social-icon" data-toggle="tooltip" title="{$s['key']}">
                                <i class="{$s['icon']}"></i>
                            </a>
                        {/foreach}
                    {/if}
                </div>
                <div class="online-subtext">
                    {if $isOnline}
                        <span class="status-dot green"></span>
                        <small>
                            Online since
                            {ifset $profile["online_since_text"]}
                                {$profile["online_since_text"]}
                            {elseifset $profile["online_since_ms"]}
                                {round(($profile["online_since_ms"] / 1000) / 60)} minutes
                            {else}
                                a moment
                            {/ifset}
                            {ifset $currentChannelName}
                                • talking on {ifset $currentChannelId}<a href="ts3server://web.reape.rs?cid={$currentChannelId}">{$currentChannelName}</a>{else}{$currentChannelName}{/ifset}
                            {/ifset}
                        </small>
                    {else}
                        <span class="status-dot gray"></span>
                        <small>
                            Offline{ifset $lastSeenText} • last seen {$lastSeenText}{/ifset}
                        </small>
                    {/if}
                </div>
            </div>
            {ifset $rankImageUrl}
                <div class="rank-badge">
                    <img src="{$rankImageUrl}" alt="Rank {$rankLevel}">
                </div>
            {/ifset}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-user"></i> Overview
        </div>
        <div class="card-body">
            <div class="profile-overview-grid">
                <div class="overview-stats">
                    <p><strong>Country:</strong> {ifset $profile["country"]}
                        <img src="https://reape.rs/flags/{strtolower($profile['country'])}.png" alt="flag" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;"> {$profile["country"]}
                    {else}-{/ifset}</p>
                    <p><strong>Platform:</strong> {$profile["platform"] ?? '-'}</p>
                    <p><strong>Version:</strong> {$profile["version"] ?? '-'}</p>
                </div>
                <div class="overview-description">
                    <p><strong>Description</strong></p>
                    <div class="desc">{ifset $profile["description"]}{$profile["description"]|noescape}{else}<em>No description</em>{/ifset}</div>
                    {ifset $profile["first_connected_human"]}
                        <div class="mt-3 text-muted" style="font-size:0.9rem;">
                            <i class="fas fa-user-plus"></i> <strong>First joined:</strong> {$profile["first_connected_human"]}
                        </div>
                    {/ifset}
                </div>
                <div class="overview-discord">
                    {ifset $discordId}
                    <p><strong>Discord Status</strong></p>
                    <div id="lanyard-widget" class="lanyard-widget" data-discord-id="{$discordId}">
                        <div class="lanyard-loading">
                            <i class="fas fa-spinner fa-spin"></i> Loading Discord status...
                        </div>
                    </div>
                    {else}
                    <div class="widget-placeholder">
                        <i class="fab fa-discord" style="font-size:2rem;color:#ccc;"></i>
                        <p class="text-muted mb-0" style="font-size:0.85rem;">No Discord linked</p>
                    </div>
                    {/ifset}
                </div>
                <div class="overview-steam">
                    {ifset $steamData}
                    <p><strong>Steam Status</strong></p>
                    <div class="steam-widget">
                        <div class="steam-content">
                            <a href="{$steamData['profileurl']}" target="_blank" rel="noopener">
                                <img src="{$steamData['avatarmedium']}" alt="{$steamData['personaname']}" class="steam-avatar">
                            </a>
                            <div class="steam-user-info">
                                <div class="steam-username">
                                    <a href="{$steamData['profileurl']}" target="_blank" rel="noopener">{$steamData['personaname']}</a>
                                </div>
                                {ifset $steamData['personastate']}
                                    <div class="steam-info-item"><strong>Status:</strong> <span class="status-value {$steamData['personastate']|lower|replace:' ':'-'}">{$steamData['personastate']}</span></div>
                                {/ifset}
                                <div class="steam-info-item"><strong>SteamID64:</strong> {$steamData['steamid']}</div>
                                {ifset $steamData['games_count']}
                                    <div class="steam-info-item"><strong>Games:</strong> {$steamData['games_count']}</div>
                                {/ifset}
                                {ifset $steamData['cs2_playtime']}
                                    <div class="steam-info-item"><strong>CS2:</strong> {$steamData['cs2_playtime']} hrs</div>
                                {/ifset}
                                {ifset $steamData['cs2_stats']}
                                    <div class="steam-info-item"><strong>K/D:</strong> {$steamData['cs2_stats']['kd_ratio']} | <strong>Wins:</strong> {$steamData['cs2_stats']['wins']}</div>
                                {/ifset}
                            </div>
                            {ifset $steamData['level']}
                            <div class="steam-level-badge">
                                <div class="steam-level-number">{$steamData['level']}</div>
                                <div class="steam-level-text">Level</div>
                            </div>
                            {/ifset}
                        </div>
                    </div>
                    {else}
                    <div class="widget-placeholder">
                        <i class="fab fa-steam" style="font-size:2rem;color:#ccc;"></i>
                        <p class="text-muted mb-0" style="font-size:0.85rem;">No Steam linked</p>
                    </div>
                    {/ifset}
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users"></i> Server groups
        </div>
        <div class="card-body">
            {if $groups}
                {foreach $groups as $g}
                    <span class="badge badge-primary mr-1 mb-1" data-toggle="tooltip" title="ID: {$g['sgid']}">
                        {if $g['iconid']}
                            <img src="api/geticon.php?iconid={$g['iconid']}" alt="{$g['name']}" style="height:16px;width:16px;vertical-align:middle;margin-right:.25rem;">
                        {/if}
                        {$g['name']}
                    </span>
                {/foreach}
            {else}
                <em>No groups</em>
            {/if}
        </div>
    </div>
{/block}

{block footerbottom}
{php $tplutils = Wruczek\TSWebsite\Utils\TemplateUtils::i()}
{$tplutils::includeScript("js/lanyard.js", true)}
{/block}
