{extends "body.latte"}
{var $title = 'Profile'}

{block content}
    <div class="profile-header steamlike-header card-accent">
        <div class="cover" n:attr="style => isset($bannerUrl) && $bannerUrl ? 'background-image:url(' . $bannerUrl . '); background-size:cover; background-position:center;' : null"></div>
        <div class="avatar-and-meta d-flex align-items-center">
            <div class="d-flex align-items-center">
                <div class="avatar avatar-preview">
                    <img src="{$avatarUrl}" alt="avatar" class="avatar-img">
                    <img src="{$avatarBorderUrl}" alt="avatar border" class="avatar-border-overlay">
                </div>
                <div class="meta ml-3">
                    <h3 class="nickname mb-1 d-flex align-items-center">
                        <span>{$profile["nickname"] ?? ("User #" . $profile["cldbid"]) }</span>
                        {ifset $groups}
                            {foreach $groups as $g}
                                {if $g['sgid'] === 6}
                                    <img src="https://cdn3.emoji.gg/emojis/28948-staff.png" alt="Group 6" class="ml-2" style="height:24px;width:24px;object-fit:contain;vertical-align:middle;" data-toggle="tooltip" title="Group 6">
                                    {breakIf true}
                                {/if}
                            {/foreach}
                        {/ifset}
                    </h3>
                    <div class="subtext">
                        <span><i class="fas fa-id-badge"></i> CLDBID: {$profile["cldbid"]}</span>
                        {ifset $profile["cluid"]}
                            <span class="ml-2"><i class="fas fa-fingerprint"></i> {$profile["cluid"]}</span>
                        {/ifset}
                        {if $socials}
                            <span class="ml-3">
                                {foreach $socials as $s}
                                    <a href="{$s['url']}" target="_blank" rel="noopener" class="ml-2" data-toggle="tooltip" title="{$s['key']}">
                                        <i class="{$s['icon']}"></i>
                                    </a>
                                {/foreach}
                            </span>
                        {/if}
                    </div>
                    <div class="online-subtext mt-2">
                        {if $isOnline}
                            <span class="status-dot green"></span>
                            <small>
                                Online since
                                {ifset $profile["online_since_text"]}
                                    {$profile["online_since_text"]}
                                {elseifset $profile["online_since_ms"]}
                                    {round(($profile["online_since_ms"] / 1000) / 60)} minutes
                                {else}
                                    a moment
                                {/ifset}
                                {ifset $currentChannelName}
                                    • talking on {ifset $currentChannelId}<a href="ts3server://web.reape.rs?cid={$currentChannelId}">{$currentChannelName}</a>{else}{$currentChannelName}{/ifset}
                                {/ifset}
                            </small>
                        {else}
                            <span class="status-dot gray"></span>
                            <small>
                                Offline{ifset $lastSeenText} • last seen {$lastSeenText}{/ifset}
                            </small>
                        {/if}
                    </div>
                </div>
            </div>
            {ifset $rankImageUrl}
                <div class="ml-auto">
                    <img src="{$rankImageUrl}" alt="Rank {$rankLevel}" style="height:48px;width:auto;">
                </div>
            {/ifset}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-user"></i> Overview
        </div>
        <div class="card-body">
            {ifset $steamData}
            <div class="row">
                <div class="col-md-12">
                    <div class="d-flex align-items-center mb-3">
                        <img src="{$steamData['avatar']}" alt="{$steamData['personaname']}" style="width:64px;height:64px;border-radius:4px;margin-right:1rem;">
                        <div>
                            <h5 class="mb-1">
                                <i class="fab fa-steam"></i> 
                                <a href="{$steamData['profileurl']}" target="_blank" rel="noopener">{$steamData['personaname']}</a>
                            </h5>
                            {ifset $steamData['level']}
                                <p class="mb-0"><strong>Steam Level:</strong> {$steamData['level']}</p>
                            {/ifset}
                            {ifset $steamData['countrycode']}
                                <p class="mb-0">
                                    <strong>Country:</strong> 
                                    <img src="https://steamcommunity-a.akamaihd.net/public/images/countryflags/{$steamData['countrycode']}.gif" alt="{$steamData['countrycode']}" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;">
                                </p>
                            {/ifset}
                        </div>
                    </div>
                    {ifset $steamData['recent_games']}
                    <h6><i class="fas fa-gamepad"></i> Recently Played Games</h6>
                    <div class="row">
                        {foreach $steamData['recent_games'] as $game}
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <img src="{$game['icon']}" alt="{$game['name']}" class="card-img-top" style="width:100%;height:auto;">
                                <div class="card-body p-2">
                                    <h6 class="card-title mb-1" style="font-size:0.9rem;">{$game['name']}</h6>
                                    <p class="card-text mb-0" style="font-size:0.85rem;">
                                        <strong>{round($game['playtime_forever'] / 60, 1)} hrs</strong> total
                                        {if isset($game['playtime_2weeks'])}
                                        <br><small class="text-muted">{round($game['playtime_2weeks'] / 60, 1)} hrs last 2 weeks</small>
                                        {/if}
                                    </p>
                                </div>
                            </div>
                        </div>
                        {/foreach}
                    </div>
                    {/ifset}
                </div>
            </div>
            {else}
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Country:</strong> {ifset $profile["country"]}
                        <img src="https://reape.rs/flags/{strtolower($profile['country'])}.png" alt="flag" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;"> {$profile["country"]}
                    {else}-{/ifset}</p>
                    <p><strong>Platform:</strong> {$profile["platform"] ?? '-'}</p>
                    <p><strong>Version:</strong> {$profile["version"] ?? '-'}</p>
                </div>
                <div class="col-md-6">
                    <p><em class="text-muted">No additional stats available</em></p>
                </div>
            </div>
            {/ifset}
            <hr>
            <div class="row">
                <div class="col-md-{ifset $discordId}6{else}12{/ifset}">
                    <p><strong>Description</strong></p>
                    <div class="desc">{ifset $profile["description"]}{$profile["description"]|noescape}{else}<em>No description</em>{/ifset}</div>
                </div>
                {ifset $discordId}
                <div class="col-md-6">
                    <p><strong>Discord Status</strong></p>
                    <div id="lanyard-widget" class="lanyard-widget" data-discord-id="{$discordId}">
                        <div class="lanyard-loading">
                            <i class="fas fa-spinner fa-spin"></i> Loading Discord status...
                        </div>
                    </div>
                </div>
                {/ifset}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-users"></i> Server groups
        </div>
        <div class="card-body">
            {if $groups}
                {foreach $groups as $g}
                    <span class="badge badge-primary mr-1 mb-1" data-toggle="tooltip" title="ID: {$g['sgid']}">
                        {if $g['iconid']}
                            <img src="api/geticon.php?iconid={$g['iconid']}" alt="{$g['name']}" style="height:16px;width:16px;vertical-align:middle;margin-right:.25rem;">
                        {/if}
                        {$g['name']}
                    </span>
                {/foreach}
            {else}
                <em>No groups</em>
            {/if}
        </div>
    </div>
{/block}

{block footerbottom}
{php $tplutils = Wruczek\TSWebsite\Utils\TemplateUtils::i()}
{$tplutils::includeScript("js/lanyard.js", true)}
{/block}
