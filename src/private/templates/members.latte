{extends "body.latte"}
{var $title = 'Members list'}
{var $navActiveIndex = 6}

{block content}

    <div class="card card-accent">
        <div class="card-header bigger-title d-flex justify-content-between align-items-center">
            <span><i class="fas fa-users"></i> Members list</span>
            <button class="btn btn-sm btn-outline-primary" onclick="location.reload();" title="Refresh member data">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
        <div class="card-body">
            {if $members === null || $members === false}
                {include "utils/data-problem.latte", message => "Cannot load member data"}
            {elseif empty($members)}
                <div class="alert alert-info text-center" role="alert">
                    <i class="fas fa-info-circle"></i> No members found in configured groups.
                </div>
            {else}
                <!-- Tip shown when the table shrinks, telling you that you can tap a row to view more -->
                <div id="responsive-table-details-tip" class="alert alert-info alert-dismissible fade show" style="display: none" role="alert">
                    <i class="fas fa-info-circle"></i> Tap a row to view more details
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <!-- Loader shown when DataTables is initialising the table -->
                <div id="members-loader" class="position-relative p-3">
                    <div class="loader"></div>
                </div>

                <table id="memberlist" class="table display dt-responsive no-wrap" width="100%" style="display: none">
                    <thead>
                    <tr>
                        <th data-priority="1">Client ID</th>
                        <th data-priority="2">Nickname</th>
                        <th>Rank</th>
                        <th>Country</th>
                        <th data-priority="3">Groups</th>
                    </tr>
                    </thead>
                    <tbody>
                    {foreach $members as $m}
                        <tr>
                            <td data-order="{$m['cldbid']}">{$m['cldbid']}</td>
                            <td>
                                <a href="profile.php?cldbid={$m['cldbid']}">{$m['nickname']}</a>
                            </td>
                            <td>
                                {ifset $m['rank_iconid']}
                                    <img src="api/geticon.php?iconid={$m['rank_iconid']}" alt="rank" style="height:16px;width:16px;vertical-align:middle;" title="{ifset $m['rank_group_name']}{$m['rank_group_name']}{/ifset}">
                                    {ifset $m['rank_group_name']}
                                        <span class="d-none d-md-inline">{$m['rank_group_name']}</span>
                                    {/ifset}
                                {else}
                                    <span class="text-muted">-</span>
                                {/ifset}
                            </td>
                            <td>
                                {ifset $m['country']}
                                    <img src="https://reape.rs/flags/{strtolower($m['country'])}.png" alt="{strtoupper($m['country'])}" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;" title="{strtoupper($m['country'])}">
                                    <span class="d-none d-md-inline ml-1">{strtoupper($m['country'])}</span>
                                {else}
                                    <span class="text-muted">-</span>
                                {/ifset}
                            </td>
                            <td>
                                {if !empty($m['servergroups']) && $serverGroups}
                                    {var $displayGroups = []}
                                    {foreach $m['servergroups'] as $gid}
                                        {* Skip rank groups (996-1005) - they show in Rank column *}
                                        {if $gid >= $rankMin && $gid <= $rankMax}
                                            {continueIf true}
                                        {/if}
                                        {if isset($serverGroups[$gid])}
                                            {var $displayGroups[] = $serverGroups[$gid]['name']}
                                        {/if}
                                    {/foreach}
                                    {if !empty($displayGroups)}
                                        <span title="{implode(', ', $displayGroups)}">{implode(', ', array_slice($displayGroups, 0, 3))}{if count($displayGroups) > 3}...{/if}</span>
                                    {else}
                                        <span class="text-muted">-</span>
                                    {/if}
                                {else}
                                    <span class="text-muted">-</span>
                                {/if}
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>
            {/if}
        </div>
    </div>
{/block}

{block footerbottom}
    <script>
        var DATATABLES_LANGUAGE_NAME = "English"
    </script>

    {$tplutils::includeScript("js/members.js", true)}
{/block}
