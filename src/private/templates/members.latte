{extends "body.latte"}
{var $title = 'Members list'}
{var $navActiveIndex = 6}

{block content}
    <div class="card card-accent">
        <div class="card-header bigger-title d-flex justify-content-between align-items-center">
            <span>
                <i class="fas fa-users"></i> Members list
            </span>
            <span class="text-muted">Page {$page}</span>
        </div>
        <div class="card-body">
            {if $members}
                <ul class="list-group">
                    {foreach $members as $m}
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="mb-1">
                                        <span class="text-muted mr-2">#{$m['cldbid']}</span>
                                        <a href="profile.php?cldbid={$m['cldbid']}">{$m['nickname']}</a>
                                        {ifset $m['rank_iconid']}
                                            <img src="api/geticon.php?iconid={$m['rank_iconid']}" alt="rank" style="height:16px;width:16px;vertical-align:middle;margin-left:.25rem;">
                                        {/ifset}
                                        {ifset $m['country']}
                                            <img src="https://reape.rs/flags/{strtolower($m['country'])}.png" alt="flag" style="height:11px;width:16px;border-radius:1px;vertical-align:middle;object-fit:cover;margin-left:.25rem;">
                                        {/ifset}
                                    </div>
                                    <div class="small text-muted">
                                        {ifset $m['client_created']}
                                            <span class="mr-3">
                                                <i class="fas fa-user-plus"></i> First joined: <span data-relativetime="fuzzydate" data-timestamp="{$m['client_created']}">{date('M j, Y', $m['client_created'])}</span>
                                            </span>
                                        {/ifset}
                                        {if isset($m['is_online']) && $m['is_online']}
                                            <span class="text-success">
                                                <i class="fas fa-circle"></i> Currently online
                                            </span>
                                        {elseif isset($m['client_lastconnected'])}
                                            <span>
                                                <i class="fas fa-clock"></i> Last active: <span data-relativetime="fuzzydate" data-timestamp="{$m['client_lastconnected']}">{date('M j, Y', $m['client_lastconnected'])}</span>
                                            </span>
                                        {/if}
                                    </div>
                                </div>
                                <a href="profile.php?cldbid={$m['cldbid']}" class="btn btn-sm btn-primary ml-2">View</a>
                            </div>
                        </li>
                    {/foreach}
                </ul>
                <div class="text-center mt-3">
                    {if $hasMore}
                        <a href="{$nextPageUrl}" class="btn btn-primary">Next page</a>
                    {else}
                        <span class="text-muted">No more results</span>
                    {/if}
                </div>
            {else}
                <div class="alert alert-info mb-0">
                    No members found in groups 6 or 7.
                </div>
            {/if}
        </div>
    </div>
{/block}

{block footerbottom}
    {if isset($topCountries) && !empty($topCountries)}
        <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
        <script type="text/javascript">
            google.charts.load('current', {literal}{'packages':['corechart']}{/literal});
            google.charts.setOnLoadCallback(drawCountryChart);
            
            function drawCountryChart() {
                var chartDiv = document.getElementById('countryPieChart');
                if (!chartDiv) {
                    console.log('Chart div not found');
                    return;
                }
                
                var chartData = [
                    ['Country', 'Users']
                ];
                
                {php}
                $idx = 0;
                foreach ($topCountries as $code => $count) {
                    echo "chartData.push(['" . addslashes($code) . "', " . intval($count) . "]);\n";
                    $idx++;
                }
                {/php}
                
                var data = google.visualization.arrayToDataTable(chartData);

                var options = {
                    pieSliceText: 'label',
                    slices: {
                        0: {literal}{color: '#5b8ff7', offset: 0.1}{/literal},   
                        1: {literal}{color: '#71a3ff'}{/literal},
                        2: {literal}{color: '#8ab4ff'}{/literal},
                        3: {literal}{color: '#a3c5ff'}{/literal},
                        4: {literal}{color: '#bcd6ff'}{/literal}
                    },
                    backgroundColor: 'transparent',
                    chartArea: {literal}{left: 10, top: 10, width: '90%', height: '85%'}{/literal},
                    legend: {literal}{position: 'none'}{/literal},
                    pieHole: 0,
                    tooltip: {
                        text: 'percentage',
                        showColorCode: true
                    }
                };

                var chart = new google.visualization.PieChart(chartDiv);
                chart.draw(data, options);
                
                console.log('Google Charts pie chart initialized successfully');
            }
        </script>
    {/if}
{/block}
