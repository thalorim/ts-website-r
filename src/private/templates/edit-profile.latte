{extends "body.latte"}
{var $title = 'Edit profile'}

{block content}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-user-cog"></i> Edit profile</span>
            <a class="btn btn-primary btn-xs" href="profile.php?cldbid={$cldbid}"><i class="fas fa-user"></i> View profile</a>
        </div>
        <div class="card-body">
            {ifset $message}
                <div class="alert alert-success">{$message}</div>
            {/ifset}
            {ifset $error}
                <div class="alert alert-danger">{$error}</div>
            {/ifset}

            <div class="d-flex align-items-center mb-3">
                <img src="{$currentAvatar}" alt="current avatar" style="width:96px;height:96px;border-radius:4px;border:2px solid rgba(0,0,0,.1);">
                <div class="ml-3">
                    <div class="text-muted">Current avatar</div>
                    <small>PNG/JPG/WEBP up to 2MB</small>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                {$csrfField}
                <div class="form-group">
                    <label for="avatar">Upload new avatar</label>
                    <input id="avatar" name="avatar" type="file" class="form-control-file" accept="image/png,image/jpeg,image/webp" required>
                </div>
                <button class="btn btn-primary" type="submit"><i class="fas fa-upload"></i> Save</button>
            </form>
        </div>
    </div>
{/block}

