{extends "body.latte"}
{var $title = 'Edit profile'}

{block content}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-user-cog"></i> Edit profile</span>
            <a class="btn btn-primary btn-xs" href="profile.php?cldbid={$cldbid}"><i class="fas fa-user"></i> View profile</a>
        </div>
        <div class="card-body">
            {ifset $message}
                <div class="alert alert-success">{$message}</div>
            {/ifset}
            {ifset $error}
                <div class="alert alert-danger">{$error}</div>
            {/ifset}

            <div class="d-flex align-items-center mb-3">
                <img src="{$currentAvatar}" alt="current avatar" style="width:96px;height:96px;border-radius:4px;border:2px solid rgba(0,0,0,.1);">
                <div class="ml-3">
                    <div class="text-muted">Current avatar</div>
                    <small>PNG/JPG/WEBP up to 2MB</small>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                {$csrfField}
                <input type="hidden" name="form" value="profile">
                <div class="form-group">
                    <label for="avatar">Upload new avatar</label>
                    <input id="avatar" name="avatar" type="file" class="form-control-file" accept="image/png,image/jpeg,image/webp">
                </div>
                <div class="form-group">
                    <label for="banner">Upload profile banner (optional)</label>
                    <input id="banner" name="banner" type="file" class="form-control-file" accept="image/png,image/jpeg,image/webp,image/gif">
                    <small class="form-text text-muted">PNG/JPG/WEBP/GIF up to 5MB. Animated GIFs supported.</small>
                </div>
                <hr>
                <h5 class="mb-3"><i class="fas fa-share-alt"></i> Social links</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fab fa-instagram"></i> Instagram</label>
                            <input class="form-control" name="instagram" placeholder="https://instagram.com/username" value="{$currentSocials['instagram'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-facebook"></i> Facebook</label>
                            <input class="form-control" name="facebook" placeholder="https://facebook.com/username" value="{$currentSocials['facebook'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-youtube"></i> YouTube</label>
                            <input class="form-control" name="youtube" placeholder="https://youtube.com/@channel" value="{$currentSocials['youtube'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-twitter"></i> Twitter/X</label>
                            <input class="form-control" name="twitter" placeholder="https://twitter.com/username" value="{$currentSocials['twitter'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-steam"></i> Steam</label>
                            <input class="form-control" name="steam" placeholder="https://steamcommunity.com/id/username" value="{$currentSocials['steam'] ?? ''}">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fab fa-soundcloud"></i> SoundCloud</label>
                            <input class="form-control" name="soundcloud" placeholder="https://soundcloud.com/username" value="{$currentSocials['soundcloud'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-github"></i> GitHub</label>
                            <input class="form-control" name="github" placeholder="https://github.com/username" value="{$currentSocials['github'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-telegram"></i> Telegram</label>
                            <input class="form-control" name="telegram" placeholder="https://t.me/username" value="{$currentSocials['telegram'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-twitch"></i> Twitch</label>
                            <input class="form-control" name="twitch" placeholder="https://twitch.tv/username" value="{$currentSocials['twitch'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-discord"></i> Discord user ID</label>
                            <input class="form-control" name="discord" placeholder="Enter your Discord user ID (numbers only)" inputmode="numeric" pattern="[0-9]{15,25}" title="Numbers only (15-25 digits)" value="{$currentSocials['discord'] ?? ''}">
                            <small class="form-text text-muted">Do not paste invite links like discord.gg. Only your numeric user ID is allowed.</small>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="form-group">
                    <label for="description"><i class="fas fa-align-left"></i> Profile description</label>
                    <textarea id="description" name="description" class="form-control" rows="4" placeholder="Tell others something about you...">{$currentDescription ?? ''}</textarea>
                </div>
                <button class="btn btn-primary" type="submit"><i class="fas fa-upload"></i> Save</button>
            </form>

            {if $canManageConnectivity}
                <hr class="my-4">
                <h5 class="mb-3"><i class="fas fa-server"></i> Website & TeamSpeak connectivity</h5>
                <p class="text-muted">These values are used globally by the site to display connection data and to authenticate against your TS3 server.</p>
                {ifset $connectivityMessage}
                    <div class="alert alert-success">{$connectivityMessage}</div>
                {/ifset}
                {ifset $connectivityError}
                    <div class="alert alert-danger">{$connectivityError}</div>
                {/ifset}
                <form method="post" class="mt-3">
                    {$csrfField}
                    <input type="hidden" name="form" value="connectivity">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Query hostname / IP</label>
                            <input class="form-control" name="query_hostname" value="{$connectivityFormDefaults['query_hostname'] ?? ''}" required>
                            <small class="form-text text-muted">IP or hostname used for ServerQuery (e.g. 127.0.0.1).</small>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Displayed server address</label>
                            <input class="form-control" name="query_displayip" value="{$connectivityFormDefaults['query_displayip'] ?? ''}" required>
                            <small class="form-text text-muted">Shown on the website and in ts3server:// links.</small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Query port</label>
                            <input type="number" min="1" max="65535" class="form-control" name="query_port" value="{$connectivityFormDefaults['query_port'] ?? ''}" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Server port</label>
                            <input type="number" min="1" max="65535" class="form-control" name="tsserver_port" value="{$connectivityFormDefaults['tsserver_port'] ?? ''}" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Query username</label>
                            <input class="form-control" name="query_username" value="{$connectivityFormDefaults['query_username'] ?? ''}" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Query password</label>
                            <input type="password" class="form-control" name="query_password" placeholder="Leave blank to keep the current password">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Query nickname (optional)</label>
                            <input class="form-control" name="query_nickname" value="{$connectivityFormDefaults['query_nickname'] ?? ''}">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Allowed CLDBIDs</label>
                            <input class="form-control" name="connectivity_admins" value="{$connectivityAdminsInput ?? ''}" required>
                            <small class="form-text text-muted">Comma/space separated CLDBIDs permitted to edit these settings.</small>
                        </div>
                    </div>
                    <button class="btn btn-warning" type="submit"><i class="fas fa-save"></i> Update connectivity</button>
                </form>
            {/if}
        </div>
    </div>
{/block}

