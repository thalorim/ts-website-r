{extends "body.latte"}
{var $title = 'Edit profile'}

{block content}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-user-cog"></i> Edit profile</span>
            <a class="btn btn-primary btn-xs" href="profile.php?cldbid={$cldbid}"><i class="fas fa-user"></i> View profile</a>
        </div>
        <div class="card-body">
            {ifset $message}
                <div class="alert alert-success">{$message}</div>
            {/ifset}
            {ifset $error}
                <div class="alert alert-danger">{$error}</div>
            {/ifset}

            <div class="d-flex align-items-center mb-3">
                <div class="avatar-preview mr-3">
                    <img src="{$currentAvatar}" alt="current avatar" class="avatar-img">
                    <img src="{$currentAvatarBorderUrl}" alt="selected border" class="avatar-border-overlay">
                </div>
                <div>
                    <div class="text-muted">Current avatar &amp; border</div>
                    <small>PNG/JPG/WEBP up to 2MB</small>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                {$csrfField}
                <div class="form-group">
                    <label for="avatar">Upload new avatar</label>
                    <input id="avatar" name="avatar" type="file" class="form-control-file" accept="image/png,image/jpeg,image/webp">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-circle-notch"></i> Choose avatar border</label>
                    <div class="border-options">
                        {foreach $borderOptions as $key => $border}
                            <label class="border-option">
                                <input type="radio" name="avatar_border" value="{$key}" {if $currentAvatarBorder === $key}checked{/if}>
                                <div class="border-option__body">
                                    <div class="avatar-preview avatar-preview--sm mb-2">
                                        <img src="{$currentAvatar}" alt="preview avatar" class="avatar-img">
                                        <img src="{$border['url']}" alt="{$border['label']} border" class="avatar-border-overlay">
                                    </div>
                                    <div class="font-weight-bold">{$border['label']}</div>
                                    <small class="text-muted d-block mt-1">{$border['description']}</small>
                                </div>
                            </label>
                        {/foreach}
                    </div>
                </div>
                <div class="form-group">
                    <label for="banner">Upload profile banner (optional)</label>
                    <input id="banner" name="banner" type="file" class="form-control-file" accept="image/png,image/jpeg,image/webp,image/gif">
                    <small class="form-text text-muted">PNG/JPG/WEBP/GIF up to 5MB. Animated GIFs supported.</small>
                </div>
                <hr>
                <h5 class="mb-3"><i class="fas fa-share-alt"></i> Social links</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fab fa-instagram"></i> Instagram</label>
                            <input class="form-control" name="instagram" placeholder="https://instagram.com/username" value="{$currentSocials['instagram'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-facebook"></i> Facebook</label>
                            <input class="form-control" name="facebook" placeholder="https://facebook.com/username" value="{$currentSocials['facebook'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-youtube"></i> YouTube</label>
                            <input class="form-control" name="youtube" placeholder="https://youtube.com/@channel" value="{$currentSocials['youtube'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-twitter"></i> Twitter/X</label>
                            <input class="form-control" name="twitter" placeholder="https://twitter.com/username" value="{$currentSocials['twitter'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-steam"></i> Steam</label>
                            <input class="form-control" name="steam" placeholder="https://steamcommunity.com/id/username" value="{$currentSocials['steam'] ?? ''}">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label><i class="fab fa-soundcloud"></i> SoundCloud</label>
                            <input class="form-control" name="soundcloud" placeholder="https://soundcloud.com/username" value="{$currentSocials['soundcloud'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-github"></i> GitHub</label>
                            <input class="form-control" name="github" placeholder="https://github.com/username" value="{$currentSocials['github'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-telegram"></i> Telegram</label>
                            <input class="form-control" name="telegram" placeholder="https://t.me/username" value="{$currentSocials['telegram'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-twitch"></i> Twitch</label>
                            <input class="form-control" name="twitch" placeholder="https://twitch.tv/username" value="{$currentSocials['twitch'] ?? ''}">
                        </div>
                        <div class="form-group">
                            <label><i class="fab fa-discord"></i> Discord ID</label>
                            <input class="form-control" name="discord" placeholder="Discord user ID or https://discord.com/users/123" value="{$currentSocials['discord'] ?? ''}">
                        </div>
                    </div>
                </div>
                <hr>
                <div class="form-group">
                    <label for="description"><i class="fas fa-align-left"></i> Profile description</label>
                    <textarea id="description" name="description" class="form-control" rows="4" placeholder="Tell others something about you...">{$currentDescription ?? ''}</textarea>
                </div>
                <hr>
                <h5 class="mb-3"><i class="fas fa-palette"></i> Profile Customization</h5>
                <div class="form-group">
                    <label for="profile_bg_color"><i class="fas fa-fill-drip"></i> Background Color (for avatar area)</label>
                    <div class="d-flex align-items-center">
                        <input type="color" id="profile_bg_color" name="profile_bg_color" class="form-control mr-2" style="width: 80px; height: 40px;" value="{$currentBgColor ?? '#1b2838'}">
                        <input type="text" id="profile_bg_color_hex" class="form-control" style="width: 120px;" value="{$currentBgColor ?? '#1b2838'}" pattern="^#[0-9A-Fa-f]{{6}}$" placeholder="#1b2838">
                        <button type="button" class="btn btn-secondary ml-2" id="reset_bg_color">Reset</button>
                    </div>
                    <small class="form-text text-muted">Choose a background color for the avatar area.</small>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-text-height"></i> Nickname Display Style</label>
                    <div class="nickname-style-options">
                        <label class="nickname-style-option">
                            <input type="radio" name="nickname_style" value="none" {if !$currentNicknameStyle || $currentNicknameStyle === 'none'}checked{/if}>
                            <div class="nickname-style-preview">
                                <span class="preview-text">Default Style</span>
                                <small class="text-muted d-block mt-1">No special effects</small>
                            </div>
                        </label>
                        <label class="nickname-style-option">
                            <input type="radio" name="nickname_style" value="style1" {if $currentNicknameStyle === 'style1'}checked{/if}>
                            <div class="nickname-style-preview">
                                <span class="preview-text nickname-preview-style1">Style 1</span>
                                <small class="text-muted d-block mt-1">Sparkle animation</small>
                            </div>
                        </label>
                        <label class="nickname-style-option">
                            <input type="radio" name="nickname_style" value="style2" {if $currentNicknameStyle === 'style2'}checked{/if}>
                            <div class="nickname-style-preview">
                                <span class="preview-text nickname-preview-style2">Style 2</span>
                                <small class="text-muted d-block mt-1">Cyan glow effect</small>
                            </div>
                        </label>
                        <label class="nickname-style-option">
                            <input type="radio" name="nickname_style" value="style3" {if $currentNicknameStyle === 'style3'}checked{/if}>
                            <div class="nickname-style-preview">
                                <span class="preview-text nickname-preview-style3">Style 3</span>
                                <small class="text-muted d-block mt-1">Sparkle with blue shadow</small>
                            </div>
                        </label>
                    </div>
                </div>
                <button class="btn btn-primary" type="submit"><i class="fas fa-upload"></i> Save</button>
            </form>
            <script>
                // Sync color picker with hex input
                const colorPicker = document.getElementById('profile_bg_color');
                const hexInput = document.getElementById('profile_bg_color_hex');
                const resetBtn = document.getElementById('reset_bg_color');

                colorPicker.addEventListener('input', function() {
                    hexInput.value = this.value.toUpperCase();
                });

                hexInput.addEventListener('input', function() {
                    if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
                        colorPicker.value = this.value;
                    }
                });

                resetBtn.addEventListener('click', function() {
                    colorPicker.value = '#1b2838';
                    hexInput.value = '#1b2838';
                });
            </script>
        </div>
    </div>
{/block}

